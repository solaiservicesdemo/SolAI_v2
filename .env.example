# 🔑 SolAI v2 Enterprise Environment Configuration
# Copy to .env and configure with your API keys

# ================= AI MODEL CONFIGURATION =================
# Primary: OpenRouter for AI models (required)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Alternative: Direct OpenAI (optional - for embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# ================= MEMORY SYSTEMS =================
# Working Memory: Redis (optional - falls back to in-memory)
REDIS_URL=redis://localhost:6379

# Session Memory: Supabase (optional but recommended)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Long-term Memory: Pinecone (optional - for semantic search)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=solai-conversations
PINECONE_ENVIRONMENT=us-west1-gcp

# ================= EXISTING SUPER-TOOLS INTEGRATION =================
# RealEstate AI Enterprise API Endpoints (if running)
GMAIL_API_ENDPOINT=http://localhost:3001/gmail
TWILIO_API_ENDPOINT=http://localhost:3001/twilio
CALENDAR_API_ENDPOINT=http://localhost:3001/calendar
CRM_API_ENDPOINT=http://localhost:3001/crm
DOCUMENT_PROCESSOR_ENDPOINT=http://localhost:3001/documents
MARKET_ANALYZER_ENDPOINT=http://localhost:3001/market

# Super-tool API Keys (match your existing setup)
SUPER_TOOL_API_KEY=your_existing_super_tool_api_key

# ================= CLAUDE FLOW INTEGRATION =================
# Claude Flow MCP Tools (if available)
CLAUDE_FLOW_ENDPOINT=http://localhost:3002/mcp
CLAUDE_FLOW_API_KEY=your_claude_flow_api_key
CLAUDE_FLOW_HIVE=true

# ================= SECURITY & COMPLIANCE =================
# Audit & Security
AUDIT_ENCRYPTION_KEY=32_character_hex_key_for_audit_encryption
COMPLIANCE_STORAGE_ENDPOINT=your_compliance_storage_endpoint
ENCRYPTION_KEY=64_character_hex_key_for_general_encryption

# Server Configuration
PORT=3000
NODE_ENV=development
SERVER_ID=solai-main
APP_VERSION=2.0.0

# ================= OPTIONAL INTEGRATIONS =================
# Ngrok (for mobile testing)
NGROK_DOMAIN=solai-airwrecka-demo.ngrok.app

# Performance Monitoring
PERFORMANCE_MONITORING=true
HEALTH_CHECK_INTERVAL=30000

# Development Options
FAST_BOOT=false
DEBUG_MODE=false
VERBOSE_LOGGING=false