# =============================================================================
# 🤖 SolAI v2 Enterprise Configuration
# =============================================================================

# Basic Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# AI Model APIs (REQUIRED - Copy from your existing system)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GLM_4_5_AIR_API_KEY=your_glm_api_key_here

# Database Systems (REQUIRED - Copy from your existing system)
REDIS_URL=redis://localhost:6379
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
PINECONE_API_KEY=your_pinecone_api_key_here

# Communication Services (Copy from your existing system)
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Business Integration (Copy from your existing system)
HUBSPOT_API_KEY=your_hubspot_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Google Services (Copy from your existing system)
GOOGLE_DRIVE_CLIENT_ID=your_google_drive_client_id_here
GOOGLE_SHEETS_CLIENT_ID=your_google_sheets_client_id_here
GOOGLE_SHEETS_CLIENT_SECRET=your_google_sheets_client_secret_here
GOOGLE_CALENDAR_CLIENT_ID=your_google_calendar_client_id_here
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_calendar_client_secret_here
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here

# Existing Super-Tool APIs (Connect to your RealEstate AI Enterprise endpoints)
GMAIL_API_ENDPOINT=http://localhost:3001/gmail
TWILIO_API_ENDPOINT=http://localhost:3001/twilio  
CALENDAR_API_ENDPOINT=http://localhost:3001/calendar
CRM_API_ENDPOINT=http://localhost:3001/crm
DOC_PROCESSOR_ENDPOINT=http://localhost:3001/documents
MARKET_ANALYZER_ENDPOINT=http://localhost:3001/market

# Claude Flow MCP Integration (PLACEHOLDER - Waiting on Claude Flow v2.0.0-alpha)
CLAUDE_FLOW_ENDPOINT=http://localhost:3002/mcp
CLAUDE_FLOW_API_KEY=your_claude_flow_api_key_here
CLAUDE_FLOW_HIVE=true

# Missing APIs (PLACEHOLDERS - Need to be configured)
MLS_API_KEY=your_mls_api_key_here
ZILLOW_API_KEY=your_zillow_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# Security Configuration
JWT_SECRET=your_super_secure_jwt_secret_here_make_it_long_and_random
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Performance Configuration
COST_LIMIT_DAILY=0.33
COST_LIMIT_MONTHLY=10.0
MAX_CONCURRENT_SESSIONS=25
MEMORY_CACHE_SIZE=512