# 🔑 SolAI v2 Enterprise Environment Configuration - PRODUCTION
# PRIVATE FILE - Contains live API keys for production deployment

# ================= AI MODEL CONFIGURATION =================
# Primary: OpenRouter for AI models (required)
OPENROUTER_API_KEY= YOUR_KEY_HERE

# Alternative: Direct OpenAI (optional - for embeddings)
OPENAI_API_KEY= YOUR_KEY_HERE

# Gemini API (Fallback AI)
GOOGLE_GEMINI_API_KEY= YOUR_KEY_HERE

# ================= MEMORY SYSTEMS =================
# Working Memory: Redis (production recommended)
REDIS_URL= YOUR_REDIS_URL_HERE
REDIS_API_KEY= YOUR_REDIS_API_KEY_HERE

# Session Memory: Supabase (required for production)
SUPABASE_URL= YOUR_SUPABASE_URL_HERE
SUPABASE_ANON_KEY= YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_KEY= YOUR_SUPABASE_SERVICE_KEY_HERE

# Long-term Memory: Pinecone (production semantic search)
PINECONE_API_KEY= YOUR_PINECONE_API_KEY_HERE
PINECONE_INDEX= your_pinecone_index_name_here
PINECONE_ENVIRONMENT= your_pinecone_environment_here

# ================= EXISTING SUPER-TOOLS INTEGRATION =================
# RealEstate AI Enterprise API Endpoints (production URLs)
GMAIL_API_ENDPOINT=http://localhost:3001/gmail
TWILIO_API_ENDPOINT=http://localhost:3001/twilio
CALENDAR_API_ENDPOINT=http://localhost:3001/calendar
CRM_API_ENDPOINT=http://localhost:3001/crm
DOCUMENT_PROCESSOR_ENDPOINT=http://localhost:3001/documents
MARKET_ANALYZER_ENDPOINT=http://localhost:3001/market

# Super-tool API Keys (production credentials)
SUPER_TOOL_API_KEY=your_existing_super_tool_api_key

# ================= COMMUNICATION INTEGRATIONS =================
# Twilio (SMS/Phone)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_RECOVERY_CODE=your_twilio_recovery_code_here

# Gmail API
GMAIL_CLIENT_ID= YOUR_GMAIL_CLIENT_ID_HERE
GMAIL_CLIENT_SECRET= YOUR_GMAIL_CLIENT_SECRET_HERE
GMAIL_REFRESH_TOKEN= YOUR_GMAIL_REFRESH_TOKEN_HERE

# HubSpot CRM
HUBSPOT_API_KEY= YOUR_HUBSPOT_API_KEY_HERE

# Google Sheets
GOOGLE_SHEETS_CLIENT_ID= YOUR_GOOGLE_SHEETS_CLIENT_ID_HERE
GOOGLE_SHEETS_CLIENT_SECRET= YOUR_GOOGLE_SHEETS_CLIENT_SECRET_HERE

# Telegram Bot
TELEGRAM_BOT_TOKEN= YOUR_TELEGRAM_BOT_TOKEN_HERE

# ElevenLabs (Voice)
ELEVENLABS_API_KEY= YOUR_ELEVENLABS_API_KEY_HERE

# ================= CLAUDE FLOW INTEGRATION =================
# Claude Flow MCP Tools (production)
CLAUDE_FLOW_ENDPOINT= YOUR_CLAUDE_FLOW_ENDPOINT_HERE
CLAUDE_FLOW_API_KEY= YOUR_CLAUDE_FLOW_API_KEY_HERE
CLAUDE_FLOW_HIVE=true

# ================= SECURITY & COMPLIANCE =================
# Audit & Security (generate secure keys for production)
AUDIT_ENCRYPTION_KEY=your_secure_audit_encryption_key_here
COMPLIANCE_STORAGE_ENDPOINT= your_compliance_storage_endpoint_here
ENCRYPTION_KEY=your_secure_encryption_key_here

# Server Configuration
PORT=3000
NODE_ENV=production
SERVER_ID=solai-main
APP_VERSION=2.0.0

# ================= NGROK & EXTERNAL ACCESS =================
# Ngrok (for mobile testing and remote access)
NGROK_DOMAIN=your_custom_ngrok_domain_here.ngrok-free.app
NGROK_AUTHTOKEN=your_ngrok_auth_token

# ================= PERFORMANCE & MONITORING =================
# Performance Monitoring
PERFORMANCE_MONITORING=true
HEALTH_CHECK_INTERVAL=30000

# Production Options
FAST_BOOT=true
DEBUG_MODE=false
VERBOSE_LOGGING=true

# ================= DEVELOPMENT FALLBACK =================
# Alternative Supabase (if needed)
SUPABASE_DEMO_URL= YOUR_DEMO_SUPABASE_URL_HERE
SUPABASE_DEMO_ANON=YOUR_DEMO_SUPABASE_ANON_KEY_HERE